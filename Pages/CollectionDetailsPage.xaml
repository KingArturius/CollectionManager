<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionManager.Models"
             x:Class="CollectionManager.Pages.CollectionDetailsPage"
             Title="Szczegóły kolekcji"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <Label x:Name="CollectionNameLabel"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1976D2"/>

            <CollectionView x:Name="ItemsCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected"
                            BackgroundColor="White"
                            HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame HasShadow="True"
                               CornerRadius="10"
                               Padding="10"
                               Margin="5"
                               BorderColor="#90CAF9"
                               BackgroundColor="{Binding BackgroundColor}">
                            <StackLayout>
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#212121" />
                                <Label Text="{Binding Price, StringFormat='Cena: {0:C}'}"
                                       TextColor="#555555" />
                                <Label Text="{Binding Status}"
                                       TextColor="#777777" />
                                <Label Text="{Binding Quantity, StringFormat='Ilość: {0}'}"
                                       TextColor="#777777" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Dodaj przedmiot"
                    BackgroundColor="#388E3C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="12,6"
                    Clicked="OnAddItemClicked"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
