<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionManager.Pages.ItemDetailsPage"
             Title="Szczegóły przedmiotu"
             BackgroundColor="#F5F5F5"
             Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="15">

            <Label Text="Nazwa:"
                   FontAttributes="Bold"
                   TextColor="#1976D2" />
            <Entry x:Name="NameEntry"
                   BackgroundColor="White"
                   TextColor="#212121"
                   Placeholder="Wprowadź nazwę"/>

            <Label Text="Status:"
                   FontAttributes="Bold"
                   TextColor="#1976D2" />
            <Picker x:Name="StatusPicker"
                    BackgroundColor="White"
                    TextColor="#212121"
                    Title="Wybierz status">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Nowy</x:String>
                        <x:String>Używany</x:String>
                        <x:String>Do sprzedania</x:String>
                        <x:String>Sprzedany</x:String>
                        <x:String>Do kupienia</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Cena:"
                   FontAttributes="Bold"
                   TextColor="#1976D2" />
            <Entry x:Name="PriceEntry"
                   BackgroundColor="White"
                   TextColor="#212121"
                   Keyboard="Numeric"
                   Placeholder="np. 99.99"/>

            <Label Text="Ilość:"
                   FontAttributes="Bold"
                   TextColor="#1976D2" />
            <Entry x:Name="QuantityEntry"
                   BackgroundColor="White"
                   TextColor="#212121"
                   Keyboard="Numeric"
                   Placeholder="np. 1"/>

            <Label Text="Zdjęcie:"
                   FontAttributes="Bold"
                   TextColor="#1976D2" />
            <Image x:Name="ItemImage"
                   HeightRequest="200"
                   BackgroundColor="#E0E0E0"
                   Aspect="AspectFill"
                   Margin="0,0,0,10" />

            <Button Text="Załaduj zdjęcie"
                    BackgroundColor="#FFA000"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="12,6"
                    Clicked="OnLoadImageClicked"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Zapisz zmiany"
                        BackgroundColor="#388E3C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="12,6"
                        Clicked="OnSaveClicked" />
                <Button Text="Usuń przedmiot"
                        BackgroundColor="#D32F2F"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="12,6"
                        Clicked="OnDeleteClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
